<Window x:Class="FinanceApp.Desktop.HotKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FinanceApp.Presentation.Settings;assembly=FinanceApp.Presentation"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:HotKeySettingsViewModel}"
        x:ClassModifier="internal"
        Title="FinanceApp — горячая клавиша"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Background="{StaticResource SurfaceBrush}" FontFamily="{StaticResource UiFont}">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="#262626" />
      <Setter Property="BorderBrush" Value="#3A3A3A" />
      <Setter Property="Focusable" Value="False" />
    </Style>
  </Window.Resources>

  <StackPanel Margin="20">
    <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="13">
      <Run Text="Быстрый ввод сейчас:" />
      <Run Text="{Binding Current, Mode=OneWay}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
    </TextBlock>

    <Border Margin="0,14,0,8" Padding="12,14" CornerRadius="8" BorderThickness="1"
            BorderBrush="{StaticResource AccentBrush}" Background="#0E0E0E">
      <TextBlock HorizontalAlignment="Center" FontSize="22" FontWeight="SemiBold">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding Recorded}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Recorded}" Value="">
                <Setter Property="Text" Value="нажмите сочетание…" />
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Border>

    <TextBlock Text="{Binding Message}" FontSize="12.5" TextWrapping="Wrap" MinHeight="34">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding HasProblem}" Value="True">
              <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>

    <TextBlock Margin="0,4,0,14" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
               Text="Если при нажатии ничего не меняется, сочетание перехватывает другая программа — выберите другое." />

    <DockPanel LastChildFill="False">
      <Button DockPanel.Dock="Left" Margin="0" Content="По умолчанию" Command="{Binding UseDefaultCommand}" />
      <Button DockPanel.Dock="Right" Content="Закрыть" Click="OnClose" />
      <Button DockPanel.Dock="Right" Content="Сохранить" Command="{Binding SaveCommand}"
              BorderBrush="{StaticResource AccentBrush}" />
    </DockPanel>
  </StackPanel>
</Window>
