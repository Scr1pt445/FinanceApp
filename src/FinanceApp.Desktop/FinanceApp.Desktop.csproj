<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon); WPF has none. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- LibraryImport (source-generated P/Invoke for RegisterHotKey) emits unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>FinanceApp</AssemblyName>
    <RootNamespace>FinanceApp.Desktop</RootNamespace>
    <Description>Windows desktop app: tray icon, global hotkey and the quick-entry window.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and WinForms share type names (Application, MessageBox…); keep WinForms explicit. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FinanceApp.Infrastructure\FinanceApp.Infrastructure.csproj" />
    <ProjectReference Include="..\FinanceApp.Presentation\FinanceApp.Presentation.csproj" />
  </ItemGroup>

</Project>
