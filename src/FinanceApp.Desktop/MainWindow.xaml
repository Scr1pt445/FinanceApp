<Window x:Class="FinanceApp.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FinanceApp.Desktop"
        xmlns:vm="clr-namespace:FinanceApp.Presentation.Finance;assembly=FinanceApp.Presentation"
        xmlns:domain="clr-namespace:FinanceApp.Domain;assembly=FinanceApp.Domain"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ShellViewModel}"
        x:ClassModifier="internal"
        Title="FinanceApp" Width="1180" Height="760" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13.5">
  <Window.Resources>
    <local:ShareToStarConverter x:Key="ShareToStar" />
    <local:ScaleConverter x:Key="Scale" />
    <local:BoolToVisibilityConverter x:Key="Visible" />
    <local:TextToVisibilityConverter x:Key="TextVisible" />
    <local:EqualsConverter x:Key="Equals" />
    <local:NotConverter x:Key="Not" />
    <local:RestConverter x:Key="Rest" />

    <Style TargetType="Button" BasedOn="{StaticResource FlatButton}" />
    <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}" />
    <Style TargetType="ComboBox" BasedOn="{StaticResource DarkComboBox}" />

    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
      <Setter Property="Margin" Value="4,18,0,6" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Sidebar entry: highlighted when it is the selected one. -->
    <Style x:Key="SidebarButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="Transparent" CornerRadius="8" Padding="10,8">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlBrush}" />
              </Trigger>
              <DataTrigger Value="True">
                <DataTrigger.Binding>
                  <MultiBinding Converter="{StaticResource Equals}">
                    <Binding />
                    <Binding Path="DataContext.Selected" RelativeSource="{RelativeSource AncestorType=Window}" />
                  </MultiBinding>
                </DataTrigger.Binding>
                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Amount" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tone}" Value="Income">
          <Setter Property="Foreground" Value="{StaticResource IncomeBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="Envelope">
          <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="Neutral">
          <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Segmented choice of the form (Расход / Доход / Перевод). -->
    <Style x:Key="Segment" TargetType="Button" BasedOn="{StaticResource FlatButton}">
      <Setter Property="Padding" Value="16,7" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <!-- New / edit transaction form. -->
    <DataTemplate DataType="{x:Type vm:TransactionFormViewModel}">
      <Border Width="460" Padding="22,18" CornerRadius="12" Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />

          <StackPanel Orientation="Horizontal" Margin="0,0,0,14" Visibility="{Binding IsNew, Converter={StaticResource Visible}}">
            <Button Content="Расход" Command="{Binding ChooseKindCommand}" CommandParameter="{x:Static domain:TransactionType.Expense}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource Segment}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="Expense">
                      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Content="Доход" Command="{Binding ChooseKindCommand}" CommandParameter="{x:Static domain:TransactionType.Income}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource Segment}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="Income">
                      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Content="Перевод" Command="{Binding ChooseKindCommand}" CommandParameter="{x:Static domain:TransactionType.Transfer}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource Segment}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="Transfer">
                      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </StackPanel>

          <TextBlock Text="Сумма" Style="{StaticResource Caption}" />
          <Grid Margin="0,4,0,12">
            <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" FontSize="22" Padding="10,6,60,6" Loaded="OnFocusOnLoad" />
            <TextBlock Text="{Binding AmountCurrency}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
          </Grid>

          <StackPanel Visibility="{Binding IsTransfer, Converter={StaticResource Visible}, ConverterParameter=invert}">
            <TextBlock Text="Категория" Style="{StaticResource Caption}" />
            <ItemsControl ItemsSource="{Binding Tiles}" Margin="0,6,0,8">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:CategoryTile}">
                  <Button Content="{Binding Name}" Margin="0,0,6,6" Padding="10,5"
                          Command="{Binding DataContext.ChooseCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="+ Своя категория" HorizontalAlignment="Left" Margin="0,-2,0,10" Style="{StaticResource GhostButton}"
                    Command="{Binding StartAddCategoryCommand}"
                    Visibility="{Binding IsAddingCategory, Converter={StaticResource Visible}, ConverterParameter=invert}" />
            <Grid Margin="0,0,0,12" Visibility="{Binding IsAddingCategory, Converter={StaticResource Visible}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" IsVisibleChanged="OnFocusWhenVisible"
                       ToolTip="Название новой категории; Enter — добавить">
                <TextBox.InputBindings>
                  <KeyBinding Key="Enter" Command="{Binding AddCategoryCommand}" />
                  <KeyBinding Key="Escape" Command="{Binding CancelAddCategoryCommand}" />
                </TextBox.InputBindings>
              </TextBox>
              <TextBlock Text="Название новой категории" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                         Visibility="{Binding NewCategoryName, Converter={StaticResource TextVisible}, ConverterParameter=invert}" />
              <Button Grid.Column="1" Content="Добавить" Margin="8,0,0,0" Command="{Binding AddCategoryCommand}" />
              <Button Grid.Column="2" Content="✕" Margin="4,0,0,0" Style="{StaticResource GhostButton}" Command="{Binding CancelAddCategoryCommand}" />
            </Grid>
          </StackPanel>

          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Откуда" Style="{StaticResource Caption}" Visibility="{Binding IsTransfer, Converter={StaticResource Visible}}" />
              <TextBlock Text="Счёт" Style="{StaticResource Caption}" Visibility="{Binding IsTransfer, Converter={StaticResource Visible}, ConverterParameter=invert}" />
              <ComboBox Margin="0,4,0,0" ItemsSource="{Binding Accounts}" SelectedItem="{Binding Account}" DisplayMemberPath="Name" />
            </StackPanel>
            <StackPanel Grid.Column="2" Visibility="{Binding IsTransfer, Converter={StaticResource Visible}}">
              <TextBlock Text="Куда" Style="{StaticResource Caption}" />
              <ComboBox Margin="0,4,0,0" ItemsSource="{Binding Accounts}" SelectedItem="{Binding ToAccount}" DisplayMemberPath="Name" />
            </StackPanel>
          </Grid>

          <StackPanel Margin="0,0,0,12" Visibility="{Binding NeedsReceivedAmount, Converter={StaticResource Visible}}">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <RadioButton Content="Сколько зачислено" IsChecked="{Binding UseRate, Converter={StaticResource Not}}" Foreground="{StaticResource TextBrush}" Margin="0,0,16,0" />
              <RadioButton Content="По курсу" IsChecked="{Binding UseRate}" Foreground="{StaticResource TextBrush}" />
            </StackPanel>
            <StackPanel Visibility="{Binding UseRate, Converter={StaticResource Visible}, ConverterParameter=invert}">
              <TextBlock Style="{StaticResource Caption}" Text="Зачислено (пусто — по курсу ЦБ)" />
              <Grid Margin="0,4,0,0">
                <TextBox Text="{Binding ReceivedText, UpdateSourceTrigger=PropertyChanged}" Padding="8,5,50,5" />
                <TextBlock Text="{Binding ReceivedCurrency}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
              </Grid>
            </StackPanel>
            <StackPanel Visibility="{Binding UseRate, Converter={StaticResource Visible}}">
              <TextBlock Style="{StaticResource Caption}" Text="Курс" />
              <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding RateLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Grid Grid.Column="1">
                  <TextBox Text="{Binding RateText, UpdateSourceTrigger=PropertyChanged}" Padding="8,5,50,5" />
                  <TextBlock Text="{Binding RateUnit}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                </Grid>
                <Button Grid.Column="2" Content="⇄" Margin="6,0,0,0" Style="{StaticResource GhostButton}" Command="{Binding SwapRateCommand}"
                        ToolTip="Перевернуть курс" />
              </Grid>
              <TextBlock Text="{Binding ReceivedPreview}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                         Visibility="{Binding ReceivedPreview, Converter={StaticResource TextVisible}}" />
            </StackPanel>
          </StackPanel>

          <TextBlock Text="Дата" Style="{StaticResource Caption}" />
          <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
            <TextBox Width="130" Text="{Binding DateText, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Сегодня" Margin="8,0,0,0" Style="{StaticResource GhostButton}" Command="{Binding TodayCommand}" />
            <Button Content="Вчера" Style="{StaticResource GhostButton}" Command="{Binding YesterdayCommand}" />
          </StackPanel>

          <TextBlock Text="Комментарий" Style="{StaticResource Caption}" />
          <TextBox Margin="0,4,0,12" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Text="{Binding Problem}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,4"
                     Visibility="{Binding Problem, Converter={StaticResource TextVisible}}" />
          <TextBlock Text="{Binding SaveError}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,0,4"
                     Visibility="{Binding SaveError, Converter={StaticResource TextVisible}}" />

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Отмена" Style="{StaticResource GhostButton}" Command="{Binding CancelCommand}" IsCancel="True" />
            <Button Content="Сохранить" Margin="8,0,0,0" Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}" IsDefault="True"
                    IsEnabled="{Binding CanSave}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- New / edit account or envelope form. -->
    <DataTemplate DataType="{x:Type vm:AccountFormViewModel}">
      <Border Width="420" Padding="22,18" CornerRadius="12" Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />

          <TextBlock Text="Название" Style="{StaticResource Caption}" />
          <Grid Margin="0,4,0,12">
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Loaded="OnFocusOnLoad" />
            <TextBlock Text="{Binding NamePlaceholder}" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                       Visibility="{Binding Name, Converter={StaticResource TextVisible}, ConverterParameter=invert}" />
          </Grid>

          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Начальный остаток (необязательно)" Style="{StaticResource Caption}" />
              <TextBox Margin="0,4,0,0" Text="{Binding OpeningBalanceText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Валюта" Style="{StaticResource Caption}" />
              <TextBox Margin="0,4,0,0" Text="{Binding CurrencyText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNew}" />
            </StackPanel>
          </Grid>

          <StackPanel Visibility="{Binding IsEnvelope, Converter={StaticResource Visible}}" Margin="0,0,0,12">
            <Button Content="+ Добавить цель" HorizontalAlignment="Left" Style="{StaticResource GhostButton}" Command="{Binding AddGoalCommand}"
                    Visibility="{Binding HasGoal, Converter={StaticResource Visible}, ConverterParameter=invert}" />
            <Grid Visibility="{Binding HasGoal, Converter={StaticResource Visible}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Цель" Style="{StaticResource Caption}" />
                <TextBox Margin="0,4,0,0" Text="{Binding GoalAmountText, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="К дате (необяз.)" Style="{StaticResource Caption}" />
                <TextBox Margin="0,4,0,0" Text="{Binding GoalDateText, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <Button Grid.Column="3" Content="✕" Margin="6,18,0,0" Style="{StaticResource GhostButton}" Command="{Binding RemoveGoalCommand}" ToolTip="Убрать цель" />
            </Grid>
          </StackPanel>

          <TextBlock Text="{Binding Problem}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                     Visibility="{Binding Problem, Converter={StaticResource TextVisible}}" />
          <TextBlock Text="{Binding SaveError}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"
                     Visibility="{Binding SaveError, Converter={StaticResource TextVisible}}" />

          <DockPanel Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Command="{Binding ToggleHiddenCommand}"
                    Visibility="{Binding IsNew, Converter={StaticResource Visible}, ConverterParameter=invert}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                  <Setter Property="Content" Value="Скрыть" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsHidden}" Value="True">
                      <Setter Property="Content" Value="Показать снова" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button DockPanel.Dock="Right" Content="Сохранить" Margin="8,0,0,0" Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}"
                    IsDefault="True" IsEnabled="{Binding CanSave}" />
            <Button DockPanel.Dock="Right" Content="Отмена" Style="{StaticResource GhostButton}" Command="{Binding CancelCommand}" IsCancel="True" />
          </DockPanel>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Key="Z" Modifiers="Control" Command="{Binding Operations.UndoCommand}" />
    <KeyBinding Key="F" Modifiers="Control" Command="{x:Static local:MainWindow.FocusSearchCommand}" />
    <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewExpenseCommand}" />
  </Window.InputBindings>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="290" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ===== Sidebar ===== -->
    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" Padding="14,18">
      <DockPanel>
        <CheckBox DockPanel.Dock="Bottom" Content="Показать скрытые" IsChecked="{Binding ShowHidden}" Foreground="{StaticResource MutedTextBrush}" Margin="4,10,0,0" />

        <StackPanel DockPanel.Dock="Top">
          <Border Padding="14,12" CornerRadius="10" Background="{StaticResource ControlBrush}">
            <StackPanel>
              <DockPanel>
                <ComboBox DockPanel.Dock="Right" Width="72" Padding="6,1" ItemsSource="{Binding TotalsCurrencies}" SelectedItem="{Binding TotalsCurrency}"
                          ToolTip="Валюта итогов" />
                <TextBlock Text="Всего" Style="{StaticResource Caption}" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock Text="{Binding TotalText}" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,6" />
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding AccountsTotalText}" />
                <TextBlock Text="На счетах" Style="{StaticResource Caption}" VerticalAlignment="Center" />
              </DockPanel>
              <DockPanel Margin="0,2,0,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding EnvelopesTotalText}" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="В накоплениях" Style="{StaticResource Caption}" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock Text="{Binding Warning}" Foreground="{StaticResource WarningBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                         Visibility="{Binding Warning, Converter={StaticResource TextVisible}}" />
            </StackPanel>
          </Border>

          <Button Margin="0,12,0,0" Style="{StaticResource SidebarButton}" DataContext="{Binding AllOperations}" Click="OnSidebarClick">
            <TextBlock Text="☰  Все операции" />
          </Button>
          <Button Style="{StaticResource SidebarButton}" DataContext="{Binding SummaryItem}" Click="OnSidebarClick">
            <TextBlock Text="▤  Итоги" />
          </Button>
          <Button Style="{StaticResource SidebarButton}" DataContext="{Binding CategoriesItem}" Click="OnSidebarClick">
            <TextBlock Text="◇  Категории" />
          </Button>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="+" Padding="8,0" Margin="0,14,0,0" Style="{StaticResource GhostButton}" Command="{Binding NewAccountCommand}" ToolTip="Новый счёт" />
              <TextBlock Text="СЧЕТА" Style="{StaticResource SectionHeader}" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Accounts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:SidebarItem}">
                  <Button Style="{StaticResource SidebarButton}" Click="OnSidebarClick" MouseDoubleClick="OnSidebarDoubleClick" ToolTip="Двойной клик — изменить">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding BalanceText}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                    </DockPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <DockPanel>
              <Button DockPanel.Dock="Right" Content="+" Padding="8,0" Margin="0,14,0,0" Style="{StaticResource GhostButton}" Command="{Binding NewEnvelopeCommand}" ToolTip="Новый конверт" />
              <TextBlock Text="КОНВЕРТЫ" Style="{StaticResource SectionHeader}" />
            </DockPanel>
            <TextBlock Margin="10,0,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap"
                       Text="Конверты — деньги, отложенные на цель: «Машина», «Отдых». Нажмите +, чтобы создать."
                       Visibility="{Binding Envelopes.Count, Converter={StaticResource Visible}, ConverterParameter=invert}" />
            <ItemsControl ItemsSource="{Binding Envelopes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:SidebarItem}">
                  <Button Style="{StaticResource SidebarButton}" Click="OnSidebarClick" MouseDoubleClick="OnSidebarDoubleClick" ToolTip="Двойной клик — изменить">
                    <StackPanel>
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding BalanceText}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                      </DockPanel>
                      <Grid Height="4" Margin="0,6,0,2" Visibility="{Binding HasProgress, Converter={StaticResource Visible}}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="{Binding Progress, Converter={StaticResource ShareToStar}}" />
                          <ColumnDefinition Width="{Binding Progress, Converter={StaticResource ShareToStar}, ConverterParameter=rest}" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="2" CornerRadius="2" Background="{StaticResource BorderBrush}" />
                        <Border Grid.Column="0" CornerRadius="2" Background="{StaticResource AccentBrush}" />
                      </Grid>
                      <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap"
                                 Visibility="{Binding Hint, Converter={StaticResource TextVisible}}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- ===== Operations ===== -->
    <Grid Grid.Column="1" Margin="24,18,24,14" DataContext="{Binding Operations}"
          Visibility="{Binding DataContext.IsOperations, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="False">
        <StackPanel DockPanel.Dock="Left">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" />
            <Button Content="Изменить" Margin="12,2,0,0" Padding="8,3" Style="{StaticResource GhostButton}"
                    Command="{Binding DataContext.EditAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Visibility="{Binding Account, Converter={StaticResource Visible}}" />
          </StackPanel>
          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
          <Button Content="+ Пополнить" Margin="0,0,8,0" Style="{StaticResource AccentButton}" Command="{Binding FillEnvelopeCommand}"
                  Visibility="{Binding IsEnvelopeSelected, Converter={StaticResource Visible}}" />
          <Button Content="Взять" Margin="0,0,8,0" Command="{Binding TakeFromEnvelopeCommand}"
                  Visibility="{Binding IsEnvelopeSelected, Converter={StaticResource Visible}}" />
          <Button Content="Потратить" Command="{Binding NewExpenseCommand}" ToolTip="Расход прямо из конверта (Ctrl+N)"
                  Visibility="{Binding IsEnvelopeSelected, Converter={StaticResource Visible}}" />
          <StackPanel Orientation="Horizontal" Visibility="{Binding IsEnvelopeSelected, Converter={StaticResource Visible}, ConverterParameter=invert}">
            <Button Content="− Расход" Margin="0,0,8,0" Command="{Binding NewExpenseCommand}" ToolTip="Ctrl+N" />
            <Button Content="+ Доход" Margin="0,0,8,0" Command="{Binding NewIncomeCommand}" />
            <Button Content="⇄ Перевод" Command="{Binding NewTransferCommand}" />
          </StackPanel>
        </StackPanel>
      </DockPanel>

      <Grid Grid.Row="1" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="150" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <Button Content="◀" Style="{StaticResource GhostButton}" Command="{Binding PreviousMonthCommand}" ToolTip="Предыдущий месяц" />
          <TextBlock Text="{Binding MonthTitle}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0" MinWidth="120" TextAlignment="Center" />
          <Button Content="▶" Style="{StaticResource GhostButton}" Command="{Binding NextMonthCommand}" ToolTip="Следующий месяц" />
          <Button Content="Сейчас" Margin="6,0,0,0" Style="{StaticResource GhostButton}" Command="{Binding CurrentMonthCommand}" />
        </StackPanel>
        <ComboBox Grid.Column="2" ItemsSource="{x:Static vm:OperationsViewModel.TypeChoices}" SelectedItem="{Binding TypeFilter}" />
        <Grid Grid.Column="4">
          <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Поиск по категории и комментарию (Ctrl+F)" />
          <TextBlock Text="Поиск…" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                     Visibility="{Binding Search, Converter={StaticResource TextVisible}, ConverterParameter=invert}" />
        </Grid>
      </Grid>

      <Border Grid.Row="2" CornerRadius="10" Background="{StaticResource SurfaceBrush}" Padding="6">
        <Grid>
          <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                     Text="За этот месяц операций нет.&#10;Нажмите «− Расход», «+ Доход» или горячую клавишу быстрого ввода."
                     Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Days}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DayGroup}">
                  <StackPanel Margin="8,6,8,4">
                    <DockPanel Margin="4,6,4,4">
                      <TextBlock DockPanel.Dock="Right" Text="{Binding TotalText}" Style="{StaticResource Caption}" />
                      <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}" FontWeight="SemiBold" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:OperationRow}">
                          <Border x:Name="Row" Padding="10,8" CornerRadius="8" Background="Transparent" Cursor="Hand"
                                  MouseLeftButtonDown="OnRowMouseDown" ToolTip="Двойной клик — изменить, Delete — удалить">
                            <DockPanel>
                              <StackPanel DockPanel.Dock="Right" MinWidth="120">
                                <TextBlock Text="{Binding AmountText}" Style="{StaticResource Amount}" />
                                <TextBlock Text="{Binding SecondaryAmount}" Style="{StaticResource Caption}" HorizontalAlignment="Right"
                                           Visibility="{Binding SecondaryAmount, Converter={StaticResource TextVisible}}" />
                              </StackPanel>
                              <StackPanel>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding Subtitle, Converter={StaticResource TextVisible}}" />
                              </StackPanel>
                            </DockPanel>
                          </Border>
                          <DataTemplate.Triggers>
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                              <Setter TargetName="Row" Property="Background" Value="{StaticResource ControlBrush}" />
                            </Trigger>
                            <DataTrigger Value="True">
                              <DataTrigger.Binding>
                                <MultiBinding Converter="{StaticResource Equals}">
                                  <Binding />
                                  <Binding Path="DataContext.Operations.Selected" RelativeSource="{RelativeSource AncestorType=Window}" />
                                </MultiBinding>
                              </DataTrigger.Binding>
                              <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            </DataTrigger>
                          </DataTemplate.Triggers>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <StackPanel Grid.Row="3" Margin="0,10,0,0">
        <Border HorizontalAlignment="Center" Padding="16,8" CornerRadius="8" Background="{StaticResource ControlBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Visibility="{Binding CanUndo, Converter={StaticResource Visible}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding UndoText}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button Content="Отменить (Ctrl+Z)" Style="{StaticResource AccentButton}" Command="{Binding UndoCommand}" />
            <Button Content="✕" Margin="6,0,0,0" Style="{StaticResource GhostButton}" Command="{Binding DismissUndoCommand}" ToolTip="Скрыть" />
          </StackPanel>
        </Border>
        <TextBlock Text="{Binding Status}" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"
                   Visibility="{Binding Status, Converter={StaticResource TextVisible}}" />
      </StackPanel>
    </Grid>

    <!-- ===== Summary ===== -->
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" DataContext="{Binding Summary}"
                  Visibility="{Binding DataContext.IsSummary, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}">
      <ScrollViewer.Resources>
        <!-- Colors of the «where income went» segments. -->
        <Style x:Key="FlowFill" TargetType="Border">
          <Setter Property="Background" Value="{StaticResource AccentBrush}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding Tone}" Value="Second">
              <Setter Property="Background" Value="#B58CFA" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="Other">
              <Setter Property="Background" Value="#4E3A72" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="Envelopes">
              <Setter Property="Background" Value="{StaticResource SavingBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="Free">
              <Setter Property="Background" Value="{StaticResource IncomeBrush}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>

        <!-- Notes: green for good news, orange for bad, gray otherwise. -->
        <Style x:Key="ToneText" TargetType="TextBlock">
          <Setter Property="FontSize" Value="12" />
          <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding Tone}" Value="Good">
              <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="Bad">
              <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>

        <Style x:Key="Card" TargetType="Border">
          <Setter Property="Padding" Value="16,14" />
          <Setter Property="CornerRadius" Value="10" />
          <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
          <Setter Property="FontWeight" Value="SemiBold" />
          <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <DataTemplate x:Key="AmountRowTemplate" DataType="{x:Type vm:AmountRow}">
          <DockPanel Margin="0,3">
            <TextBlock DockPanel.Dock="Right" Text="{Binding AmountText}" Margin="12,0,0,0" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
          </DockPanel>
        </DataTemplate>
      </ScrollViewer.Resources>

      <StackPanel Margin="24,18,24,18">
        <DockPanel Margin="0,0,0,14" LastChildFill="False">
          <ListBox DockPanel.Dock="Left" ItemsSource="{x:Static vm:SummaryViewModel.Choices}" SelectedItem="{Binding Choice}"
                   Background="Transparent" BorderThickness="0">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Root" Padding="12,6" Margin="0,0,4,0" CornerRadius="8" Background="Transparent">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                          <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="◀" Style="{StaticResource GhostButton}" Command="{Binding PreviousCommand}" />
            <StackPanel VerticalAlignment="Center" Margin="6,0">
              <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Center"
                         Visibility="{Binding ProgressText, Converter={StaticResource TextVisible}}" />
            </StackPanel>
            <Button Content="▶" Style="{StaticResource GhostButton}" Command="{Binding NextCommand}" />
          </StackPanel>
        </DockPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,14" Visibility="{Binding IsCustom, Converter={StaticResource Visible}}">
          <TextBlock Text="с" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
          <TextBox Width="110" Text="{Binding CustomFrom, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="по" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,6,0" />
          <TextBox Width="110" Text="{Binding CustomTo, UpdateSourceTrigger=PropertyChanged}" />
          <Button Content="Показать" Margin="10,0,0,0" Command="{Binding ApplyCustomCommand}" />
        </StackPanel>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
          <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,20"
                     Text="За этот период операций нет. Выберите другой период или добавьте операцию." />
        </Border>

        <!-- Where income went -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding HasFlow, Converter={StaticResource Visible}}">
          <StackPanel>
            <TextBlock Text="Куда ушёл доход" Style="{StaticResource CardTitle}" />
            <TextBlock Text="{Binding IncomeText}" Style="{StaticResource Caption}" Margin="0,0,0,4" />
            <local:ProportionalPanel Height="14">
              <Border local:ProportionalPanel.Weight="{Binding IncomeShare}" CornerRadius="3" Background="{StaticResource IncomeBrush}" Opacity="0.85" />
              <Border local:ProportionalPanel.Weight="{Binding IncomeShare, Converter={StaticResource Rest}}" />
            </local:ProportionalPanel>
            <TextBlock Text="{Binding OutflowText}" Style="{StaticResource Caption}" Margin="0,10,0,4" />
            <local:ProportionalPanel Height="14">
              <ItemsControl local:ProportionalPanel.Weight="{Binding OutflowShare}" ItemsSource="{Binding FlowSegments}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <local:ProportionalPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                  <Style TargetType="ContentPresenter">
                    <Setter Property="local:ProportionalPanel.Weight" Value="{Binding Weight}" />
                  </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:FlowSegment}">
                    <Border Style="{StaticResource FlowFill}" CornerRadius="3" Margin="0,0,2,0">
                      <Border.ToolTip>
                        <TextBlock>
                          <Run Text="{Binding Label, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding AmountText, Mode=OneWay}" />
                        </TextBlock>
                      </Border.ToolTip>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border local:ProportionalPanel.Weight="{Binding OutflowShare, Converter={StaticResource Rest}}" />
            </local:ProportionalPanel>
            <ItemsControl ItemsSource="{Binding FlowSegments}" Margin="0,10,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:FlowSegment}">
                  <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                    <Border Style="{StaticResource FlowFill}" Width="10" Height="10" CornerRadius="2" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource Caption}">
                      <Run Text="{Binding Label, Mode=OneWay}" /> <Run Text="{Binding AmountText, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                    </TextBlock>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding FlowNote}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12.5"
                       Visibility="{Binding FlowNote, Converter={StaticResource TextVisible}}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding FlowNoteIsWarning}" Value="True">
                      <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Border>

        <!-- Cards -->
        <ItemsControl ItemsSource="{Binding Cards}" Margin="-6,0,-6,12">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:InsightCard}">
              <Border Margin="6,0" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}" />
                  <TextBlock Text="{Binding ValueText}" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,2" />
                  <TextBlock Text="{Binding Note}" Style="{StaticResource ToneText}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Pace -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}, ConverterParameter=invert}">
          <StackPanel>
            <DockPanel Margin="0,0,0,4">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="14" Height="3" CornerRadius="1" Background="{StaticResource AccentBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                <TextBlock Text="этот период" Style="{StaticResource Caption}" Margin="0,0,14,0" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding HasPreviousPace, Converter={StaticResource Visible}}">
                  <Line X1="0" X2="14" Y1="1" Y2="1" Stroke="{StaticResource MutedTextBrush}" StrokeThickness="1.5" StrokeDashArray="2 2" Margin="0,0,5,0" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding PreviousLegend}" Style="{StaticResource Caption}" Margin="0,0,14,0" />
                </StackPanel>
                <Border Width="8" Height="10" CornerRadius="1" Background="#4E3A72" Margin="0,0,5,0" VerticalAlignment="Center" />
                <TextBlock Text="траты" Style="{StaticResource Caption}" />
              </StackPanel>
              <TextBlock Text="{Binding PaceTitle}" FontWeight="SemiBold" />
            </DockPanel>
            <TextBlock Text="{Binding PaceCaption}" Style="{StaticResource Caption}" Margin="0,0,0,10" />
            <local:PaceChart Height="170" Data="{Binding Pace}" BarBrush="#4E3A72" LineBrush="{StaticResource AccentBrush}"
                             PreviousBrush="{StaticResource MutedTextBrush}" AxisBrush="{StaticResource BorderBrush}" />
            <DockPanel Margin="0,4,0,0">
              <TextBlock DockPanel.Dock="Right" Text="{Binding PaceEndLabel}" Style="{StaticResource Caption}" FontSize="11" />
              <TextBlock Text="{Binding PaceStartLabel}" Style="{StaticResource Caption}" FontSize="11" />
            </DockPanel>
          </StackPanel>
        </Border>

        <!-- Categories | biggest expenses and incomes -->
        <Grid Margin="0,0,0,12" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}, ConverterParameter=invert}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="5*" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Расходы по категориям" Style="{StaticResource CardTitle}" />
              <TextBlock Text="Расходов за период нет" Style="{StaticResource Caption}"
                         Visibility="{Binding Categories.Count, Converter={StaticResource Visible}, ConverterParameter=invert}" />
              <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:CategoryRow}">
                    <StackPanel Margin="0,0,0,9">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding AmountText}" Margin="10,0,0,0" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ChangeText}" FontSize="12" VerticalAlignment="Center">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding ChangeTone}" Value="Good">
                                  <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ChangeTone}" Value="Bad">
                                  <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      </DockPanel>
                      <local:ProportionalPanel Height="4" Margin="0,5,0,0">
                        <Border local:ProportionalPanel.Weight="{Binding Share}" CornerRadius="2" Background="{StaticResource AccentBrush}" />
                        <Border local:ProportionalPanel.Weight="{Binding Share, Converter={StaticResource Rest}}" CornerRadius="2" Background="{StaticResource ControlBrush}" />
                      </local:ProportionalPanel>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <StackPanel Grid.Column="2">
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding TopExpenses.Count, Converter={StaticResource Visible}}">
              <StackPanel>
                <TextBlock Text="Крупные траты" Style="{StaticResource CardTitle}" />
                <ItemsControl ItemsSource="{Binding TopExpenses}" ItemTemplate="{StaticResource AmountRowTemplate}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Visibility="{Binding Incomes.Count, Converter={StaticResource Visible}}">
              <StackPanel>
                <TextBlock Text="Доходы" Style="{StaticResource CardTitle}" />
                <ItemsControl ItemsSource="{Binding Incomes}" ItemTemplate="{StaticResource AmountRowTemplate}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <!-- Envelopes -->
        <Border Style="{StaticResource Card}" Visibility="{Binding Envelopes.Count, Converter={StaticResource Visible}}">
          <StackPanel>
            <TextBlock Text="Конверты за период" Style="{StaticResource CardTitle}" />
            <ItemsControl ItemsSource="{Binding Envelopes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:EnvelopeRow}">
                  <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="140" />
                      <ColumnDefinition Width="2*" />
                      <ColumnDefinition Width="14" />
                      <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <local:ProportionalPanel Grid.Column="1" Height="6" VerticalAlignment="Center" Visibility="{Binding HasGoal, Converter={StaticResource Visible}}">
                      <Border local:ProportionalPanel.Weight="{Binding Progress}" CornerRadius="3" Background="{StaticResource AccentBrush}" />
                      <Border local:ProportionalPanel.Weight="{Binding Progress, Converter={StaticResource Rest}}" CornerRadius="3" Background="{StaticResource ControlBrush}" />
                    </local:ProportionalPanel>
                    <TextBlock Grid.Column="3" Text="{Binding Note}" Style="{StaticResource ToneText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding EnvelopeWarnings}" Margin="0,8,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Foreground="{StaticResource WarningBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,2" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <TextBlock Text="{Binding Status}" Foreground="{StaticResource WarningBrush}" Margin="0,10,0,0"
                   Visibility="{Binding Status, Converter={StaticResource TextVisible}}" />
      </StackPanel>
    </ScrollViewer>

    <!-- ===== Categories ===== -->
    <Grid Grid.Column="1" Margin="24,18,24,14" DataContext="{Binding Categories}"
          Visibility="{Binding DataContext.IsCategories, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.Resources>
        <DataTemplate DataType="{x:Type vm:CategoryItem}">
          <Border x:Name="Row" Padding="10,6" CornerRadius="8" Background="Transparent">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Переименовать" Style="{StaticResource GhostButton}" Command="{Binding StartRenameCommand}"
                        Visibility="{Binding IsEditing, Converter={StaticResource Visible}, ConverterParameter=invert}" />
                <Button Content="Готово" Style="{StaticResource GhostButton}" Command="{Binding FinishRenameCommand}"
                        Visibility="{Binding IsEditing, Converter={StaticResource Visible}}" />
                <Button Command="{Binding ToggleHiddenCommand}">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                      <Setter Property="Content" Value="Скрыть" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsHidden}" Value="True">
                          <Setter Property="Content" Value="Показать" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
              </StackPanel>
              <Grid VerticalAlignment="Center">
                <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource Visible}, ConverterParameter=invert}">
                  <TextBlock x:Name="CategoryName" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding UsageText}" Style="{StaticResource Caption}" FontSize="11" />
                </StackPanel>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" IsVisibleChanged="OnFocusWhenVisible"
                         Visibility="{Binding IsEditing, Converter={StaticResource Visible}}">
                  <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding FinishRenameCommand}" />
                    <KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}" />
                  </TextBox.InputBindings>
                </TextBox>
              </Grid>
            </DockPanel>
          </Border>
          <DataTemplate.Triggers>
            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{StaticResource ControlBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsHidden}" Value="True">
              <Setter TargetName="CategoryName" Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </Grid.Resources>

      <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="False">
        <StackPanel DockPanel.Dock="Left">
          <TextBlock Text="Категории" FontSize="24" FontWeight="SemiBold" />
          <TextBlock Text="Скрытые категории не предлагаются при вводе, но остаются в истории и итогах." Style="{StaticResource Caption}" Margin="0,2,0,0" />
        </StackPanel>
        <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center" Content="Показать скрытые" IsChecked="{Binding ShowHidden}" Foreground="{StaticResource MutedTextBrush}" />
      </DockPanel>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="14" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Padding="12" CornerRadius="10" Background="{StaticResource SurfaceBrush}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Расходы" FontWeight="SemiBold" Margin="4,0,0,10" />
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding NewExpenseName, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                  <KeyBinding Key="Enter" Command="{Binding AddExpenseCommand}" />
                </TextBox.InputBindings>
              </TextBox>
              <TextBlock Text="Новая категория расходов…" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                         Visibility="{Binding NewExpenseName, Converter={StaticResource TextVisible}, ConverterParameter=invert}" />
              <Button Grid.Column="1" Content="+ Добавить" Margin="8,0,0,0" Command="{Binding AddExpenseCommand}" />
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Expenses}" />
            </ScrollViewer>
          </DockPanel>
        </Border>
        <Border Grid.Column="2" Padding="12" CornerRadius="10" Background="{StaticResource SurfaceBrush}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Доходы" FontWeight="SemiBold" Margin="4,0,0,10" />
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding NewIncomeName, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                  <KeyBinding Key="Enter" Command="{Binding AddIncomeCommand}" />
                </TextBox.InputBindings>
              </TextBox>
              <TextBlock Text="Новая категория доходов…" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                         Visibility="{Binding NewIncomeName, Converter={StaticResource TextVisible}, ConverterParameter=invert}" />
              <Button Grid.Column="1" Content="+ Добавить" Margin="8,0,0,0" Command="{Binding AddIncomeCommand}" />
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Incomes}" />
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>

      <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{StaticResource WarningBrush}" Margin="0,10,0,0"
                 Visibility="{Binding Status, Converter={StaticResource TextVisible}}" />
    </Grid>

    <!-- ===== Forms over a dimmed window ===== -->
    <Grid Grid.ColumnSpan="2" Background="#B3000000" Visibility="{Binding HasForm, Converter={StaticResource Visible}}">
      <ContentControl Content="{Binding Form}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      <ContentControl Content="{Binding AccountForm}" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
  </Grid>
</Window>
