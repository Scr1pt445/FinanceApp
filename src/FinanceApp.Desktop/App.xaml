<Application x:Class="FinanceApp.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <!-- Dark theme: black background, purple accent (requirements, section 6). -->
    <Color x:Key="AccentColor">#9446F8</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#141414" />
    <SolidColorBrush x:Key="TextBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#8C8C8C" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F5A35C" />
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
  </Application.Resources>
</Application>
