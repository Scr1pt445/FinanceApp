<?xml version="1.0" encoding="utf-8" ?>
<!-- The desktop's dark theme (src/FinanceApp.Desktop/Themes/Dark.xaml), sized for a phone. Colors match Palette.cs. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:local="clr-namespace:FinanceApp.Mobile"
                    xmlns:controls="clr-namespace:FinanceApp.Mobile.Controls">
  <Color x:Key="Accent">#9446F8</Color>
  <Color x:Key="AccentSoft">#339446F8</Color>
  <Color x:Key="AccentLight">#B58CFA</Color>
  <Color x:Key="AccentDeep">#4E3A72</Color>
  <Color x:Key="Window">#0B0B0B</Color>
  <Color x:Key="Surface">#141414</Color>
  <Color x:Key="Control">#1C1C1C</Color>
  <Color x:Key="Border">#2E2E2E</Color>
  <Color x:Key="Text">#F2F2F2</Color>
  <Color x:Key="MutedText">#8C8C8C</Color>
  <Color x:Key="Warning">#F5A35C</Color>
  <Color x:Key="Income">#5BC77D</Color>
  <Color x:Key="Saving">#7FB2FF</Color>

  <local:IsNotEmptyConverter x:Key="IsNotEmpty" />
  <local:IsEmptyConverter x:Key="IsEmpty" />
  <local:InvertBoolConverter x:Key="Not" />
  <local:AmountToneColorConverter x:Key="AmountToneColor" />
  <local:NoteToneColorConverter x:Key="NoteToneColor" />
  <local:FlowToneColorConverter x:Key="FlowToneColor" />
  <local:DateTextConverter x:Key="DateText" />

  <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
    <Setter Property="BackgroundColor" Value="{StaticResource Window}" />
  </Style>

  <!-- Text -->
  <Style TargetType="Label">
    <Setter Property="TextColor" Value="{StaticResource Text}" />
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style x:Key="Muted" TargetType="Label">
    <Setter Property="TextColor" Value="{StaticResource MutedText}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style x:Key="PageTitle" TargetType="Label">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontAttributes" Value="Bold" />
  </Style>
  <Style x:Key="SectionTitle" TargetType="Label">
    <Setter Property="TextColor" Value="{StaticResource MutedText}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontAttributes" Value="Bold" />
    <Setter Property="VerticalOptions" Value="Center" />
  </Style>
  <Style x:Key="Big" TargetType="Label">
    <Setter Property="FontSize" Value="34" />
    <Setter Property="FontAttributes" Value="Bold" />
  </Style>
  <Style x:Key="Amount" TargetType="Label">
    <Setter Property="FontAttributes" Value="Bold" />
    <Setter Property="HorizontalTextAlignment" Value="End" />
  </Style>
  <Style x:Key="Problem" TargetType="Label">
    <Setter Property="TextColor" Value="{StaticResource Warning}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style x:Key="FieldLabel" TargetType="Label">
    <Setter Property="TextColor" Value="{StaticResource MutedText}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Margin" Value="2,6,0,0" />
  </Style>

  <!-- Inputs: transparent, inside a Field plate that draws the background, the corners and the focus. -->
  <Style TargetType="controls:Field" ApplyToDerivedTypes="True">
    <Setter Property="BackgroundColor" Value="{StaticResource Control}" />
    <Setter Property="Stroke" Value="{StaticResource Border}" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="StrokeShape" Value="RoundRectangle 14" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinimumHeightRequest" Value="52" />
  </Style>
  <Style TargetType="Entry">
    <Setter Property="TextColor" Value="{StaticResource Text}" />
    <Setter Property="PlaceholderColor" Value="{StaticResource MutedText}" />
    <Setter Property="BackgroundColor" Value="Transparent" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="MinimumHeightRequest" Value="50" />
    <Setter Property="VerticalOptions" Value="Center" />
  </Style>
  <Style TargetType="Picker">
    <Setter Property="TextColor" Value="{StaticResource Text}" />
    <Setter Property="TitleColor" Value="{StaticResource MutedText}" />
    <Setter Property="BackgroundColor" Value="Transparent" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="MinimumHeightRequest" Value="50" />
    <Setter Property="VerticalOptions" Value="Center" />
  </Style>
  <Style TargetType="DatePicker">
    <Setter Property="TextColor" Value="{StaticResource Text}" />
    <Setter Property="BackgroundColor" Value="Transparent" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="MinimumHeightRequest" Value="50" />
    <Setter Property="VerticalOptions" Value="Center" />
    <Setter Property="Format" Value="d MMMM yyyy" />
  </Style>
  <!-- A unit or a hint at the right edge of a field: «₽», «USD». -->
  <Style x:Key="FieldSuffix" TargetType="Label">
    <Setter Property="TextColor" Value="{StaticResource MutedText}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="VerticalOptions" Value="Center" />
  </Style>
  <Style TargetType="Switch">
    <Setter Property="OnColor" Value="{StaticResource AccentSoft}" />
    <Setter Property="ThumbColor" Value="{StaticResource Accent}" />
  </Style>
  <Style TargetType="ProgressBar">
    <Setter Property="ProgressColor" Value="{StaticResource Accent}" />
    <Setter Property="BackgroundColor" Value="{StaticResource Control}" />
  </Style>
  <Style TargetType="ActivityIndicator">
    <Setter Property="Color" Value="{StaticResource Accent}" />
  </Style>

  <!-- Buttons: the accent one saves, the soft one is everything else. -->
  <Style TargetType="Button">
    <Setter Property="TextColor" Value="White" />
    <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
    <Setter Property="FontAttributes" Value="Bold" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="MinimumHeightRequest" Value="48" />
    <Setter Property="VisualStateManager.VisualStateGroups">
      <VisualStateGroupList>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Property="Opacity" Value="0.45" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateGroupList>
    </Setter>
  </Style>
  <Style x:Key="Soft" TargetType="Button">
    <Setter Property="TextColor" Value="{StaticResource Text}" />
    <Setter Property="BackgroundColor" Value="{StaticResource Control}" />
    <Setter Property="FontAttributes" Value="None" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="MinimumHeightRequest" Value="44" />
  </Style>
  <Style x:Key="Chip" TargetType="Button">
    <Setter Property="TextColor" Value="{StaticResource Text}" />
    <Setter Property="BackgroundColor" Value="{StaticResource Control}" />
    <Setter Property="FontAttributes" Value="None" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="HeightRequest" Value="36" />
    <Setter Property="MinimumHeightRequest" Value="36" />
  </Style>
  <Style x:Key="Link" TargetType="Button">
    <Setter Property="TextColor" Value="{StaticResource AccentLight}" />
    <Setter Property="BackgroundColor" Value="Transparent" />
    <Setter Property="FontAttributes" Value="None" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinimumHeightRequest" Value="40" />
  </Style>
  <Style x:Key="Fab" TargetType="Button">
    <Setter Property="TextColor" Value="White" />
    <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="WidthRequest" Value="58" />
    <Setter Property="HeightRequest" Value="58" />
    <Setter Property="CornerRadius" Value="29" />
    <Setter Property="HorizontalOptions" Value="End" />
    <Setter Property="VerticalOptions" Value="End" />
    <Setter Property="Margin" Value="0,0,18,18" />
  </Style>

  <!-- Surfaces -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
    <Setter Property="Stroke" Value="{StaticResource Border}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="StrokeShape" Value="RoundRectangle 16" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style x:Key="Row" TargetType="Border">
    <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
    <Setter Property="StrokeThickness" Value="0" />
    <Setter Property="StrokeShape" Value="RoundRectangle 12" />
    <Setter Property="Padding" Value="14,11" />
  </Style>
  <Style x:Key="Tile" TargetType="Border">
    <Setter Property="BackgroundColor" Value="{StaticResource Control}" />
    <Setter Property="Stroke" Value="{StaticResource Border}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="StrokeShape" Value="RoundRectangle 12" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Margin" Value="0,0,8,8" />
  </Style>
  <Style x:Key="Dot" TargetType="BoxView">
    <Setter Property="WidthRequest" Value="10" />
    <Setter Property="HeightRequest" Value="10" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="VerticalOptions" Value="Center" />
  </Style>
</ResourceDictionary>
