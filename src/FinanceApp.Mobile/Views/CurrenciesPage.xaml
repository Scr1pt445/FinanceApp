<?xml version="1.0" encoding="utf-8" ?>
<!-- «Валюты»: which currencies the app offers. The base one and those of the accounts stay; the rest come and go. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:finance="clr-namespace:FinanceApp.Presentation.Finance;assembly=FinanceApp.Presentation"
             xmlns:controls="clr-namespace:FinanceApp.Mobile.Controls"
             x:Class="FinanceApp.Mobile.Views.CurrenciesPage"
             x:DataType="finance:CurrenciesViewModel"
             Title="Валюты">
  <ScrollView>
    <VerticalStackLayout Spacing="10" Padding="16,16,16,24">
      <Grid ColumnDefinitions="Auto,*">
        <Button Text="‹ Назад" Style="{StaticResource Link}" Clicked="OnBack" Padding="0" />
      </Grid>
      <Label Text="Валюты" Style="{StaticResource PageTitle}" />
      <Label Text="Эти валюты приложение предлагает в формах, курсах, долгах и в «Всего». Основная и валюты ваших счетов есть всегда — остальные добавляйте и убирайте как удобно."
             Style="{StaticResource Muted}" />
      <Label Text="{Binding Status}" Style="{StaticResource Problem}"
             IsVisible="{Binding Status, Converter={StaticResource IsNotEmpty}}" />

      <Label Text="МОИ ВАЛЮТЫ" Style="{StaticResource SectionTitle}" Margin="4,8,0,0" />
      <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Chosen}">
        <BindableLayout.ItemTemplate>
          <DataTemplate x:DataType="finance:CurrencyRow">
            <Border Style="{StaticResource Row}" Padding="16,10">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                  <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" />
                  <Label Text="{Binding Name}" Style="{StaticResource Muted}" />
                  <Label Text="{Binding Note}" FontSize="12" TextColor="{StaticResource AccentLight}"
                         IsVisible="{Binding Note, Converter={StaticResource IsNotEmpty}}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Убрать" Style="{StaticResource Soft}" FontSize="13" Padding="14,0"
                        HeightRequest="36" MinimumHeightRequest="36" VerticalOptions="Center"
                        IsVisible="{Binding CanRemove}" Clicked="OnRemove" />
              </Grid>
            </Border>
          </DataTemplate>
        </BindableLayout.ItemTemplate>
      </VerticalStackLayout>

      <Label Text="ДОБАВИТЬ" Style="{StaticResource SectionTitle}" Margin="4,12,0,0" />
      <controls:Field>
        <Entry Text="{Binding Search}" Placeholder="Название или код: тенге, KZT" />
      </controls:Field>
      <Button Text="{Binding CustomTitle}" Style="{StaticResource Soft}" Command="{Binding AddCustomCommand}"
              IsVisible="{Binding HasCustomCode}" />
      <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Available}">
        <BindableLayout.ItemTemplate>
          <DataTemplate x:DataType="finance:CurrencyRow">
            <Border Style="{StaticResource Row}" Padding="16,10">
              <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnAdd" />
              </Border.GestureRecognizers>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="2">
                  <Label Text="{Binding Title}" FontSize="15" />
                  <Label Text="{Binding Name}" Style="{StaticResource Muted}" />
                </VerticalStackLayout>
                <Label Grid.Column="1" Text="+" FontSize="24" TextColor="{StaticResource AccentLight}" VerticalOptions="Center" />
              </Grid>
            </Border>
          </DataTemplate>
        </BindableLayout.ItemTemplate>
      </VerticalStackLayout>
      <Label Text="Курсы берутся у ЦБ РФ. Если у ЦБ такой валюты нет, задайте свой курс в «Ещё → Курсы валют»."
             Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
