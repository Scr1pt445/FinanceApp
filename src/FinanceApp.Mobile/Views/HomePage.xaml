<?xml version="1.0" encoding="utf-8" ?>
<!-- Phone-first: the total on top, the quick-entry line under it, then the full forms and the latest operations. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FinanceApp.Mobile.Controls"
             xmlns:home="clr-namespace:FinanceApp.Presentation.Home;assembly=FinanceApp.Presentation"
             xmlns:finance="clr-namespace:FinanceApp.Presentation.Finance;assembly=FinanceApp.Presentation"
             xmlns:quick="clr-namespace:FinanceApp.Presentation.QuickEntry;assembly=FinanceApp.Presentation"
             x:Class="FinanceApp.Mobile.Views.HomePage"
             x:DataType="home:HomeViewModel"
             Title="Главная">

  <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12" Padding="16,16,16,0">

    <VerticalStackLayout Spacing="2">
      <Label Text="Всего" Style="{StaticResource Muted}" />
      <Label Text="{Binding TotalText}" Style="{StaticResource Big}" />
      <Label Text="{Binding TotalDetails}" Style="{StaticResource Muted}" />
      <!-- Gray, not orange: missing rates are a note about the total, not an error. -->
      <Label Text="{Binding Warning, StringFormat='ⓘ {0}'}" Style="{StaticResource Muted}"
             IsVisible="{Binding Warning, Converter={StaticResource IsNotEmpty}}" />
      <Button Text="Задать свой курс ›" Style="{StaticResource Link}" HorizontalOptions="Start" Padding="0"
              Clicked="OnRates" IsVisible="{Binding Warning, Converter={StaticResource IsNotEmpty}}" />
    </VerticalStackLayout>

    <!-- The one-line entry, for those who switched it on in «Ещё → Настройки». -->
    <VerticalStackLayout Grid.Row="1" Spacing="6" IsVisible="{Binding QuickEntryOn}">
      <Border Style="{StaticResource Card}" Padding="14,12">
        <VerticalStackLayout Spacing="6" BindingContext="{Binding QuickEntry}" x:DataType="quick:QuickEntryViewModel">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <!-- Prediction and spell check would "correct" «еда» and the amounts under the user's fingers. -->
            <controls:Field>
              <Entry x:Name="Line" Text="{Binding Input}" Placeholder="350 еда кофе"
                     ReturnType="Done" ReturnCommand="{Binding SaveCommand}"
                     IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                     ClearButtonVisibility="WhileEditing" />
            </controls:Field>
            <Button Grid.Column="1" Text="✓" FontSize="20" WidthRequest="52" HeightRequest="52" Padding="0"
                    CornerRadius="14" Command="{Binding SaveCommand}" />
          </Grid>
          <Label Text="{Binding Headline}" FontSize="17" FontAttributes="Bold"
                 IsVisible="{Binding Headline, Converter={StaticResource IsNotEmpty}}" />
          <Label Text="{Binding Details}"
                 IsVisible="{Binding Details, Converter={StaticResource IsNotEmpty}}" />
          <Label Text="{Binding Message}" Style="{StaticResource Muted}">
            <Label.Triggers>
              <DataTrigger TargetType="Label" Binding="{Binding HasProblem}" Value="True">
                <Setter Property="TextColor" Value="{StaticResource Warning}" />
              </DataTrigger>
            </Label.Triggers>
          </Label>
        </VerticalStackLayout>
      </Border>
      <Label Text="{Binding LastSaved}" TextColor="{StaticResource Income}" FontSize="13"
             IsVisible="{Binding LastSaved, Converter={StaticResource IsNotEmpty}}" />
    </VerticalStackLayout>

    <!-- The forms: the main way to record unless the line is on. Expense is the common case, so it stands out. -->
    <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="8">
      <Button Text="− Расход" HeightRequest="56" Clicked="OnNewExpense" />
      <Button Grid.Column="1" Text="+ Доход" Style="{StaticResource Soft}" HeightRequest="56" Clicked="OnNewIncome" />
      <Button Grid.Column="2" Text="⇄ Перевод" Style="{StaticResource Soft}" HeightRequest="56" Clicked="OnNewTransfer" />
    </Grid>

    <CollectionView Grid.Row="3" ItemsSource="{Binding Recent}" SelectionMode="None">
      <CollectionView.Header>
        <VerticalStackLayout Spacing="8">
          <!-- Recurring operations that are due: record with one tap (the amount may be corrected) or skip. -->
          <VerticalStackLayout Spacing="8" IsVisible="{Binding HasDue}" Margin="0,4,0,4">
            <Label Text="ПОРА ЗАПИСАТЬ" Style="{StaticResource SectionTitle}" />
            <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Due}">
              <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="finance:DueItem">
                  <Border Style="{StaticResource Card}" Stroke="{StaticResource AccentDeep}" Padding="14,12">
                    <VerticalStackLayout Spacing="8">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Text="↻" FontSize="22" TextColor="{StaticResource AccentLight}" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                          <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                          <Label Text="{Binding Details}" Style="{StaticResource Muted}" />
                        </VerticalStackLayout>
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <controls:Field MinimumHeightRequest="44">
                          <Entry Text="{Binding AmountText}" Keyboard="Numeric" FontSize="16" MinimumHeightRequest="44" />
                        </controls:Field>
                        <Button Grid.Column="1" Text="Записать" HeightRequest="44" MinimumHeightRequest="44" Command="{Binding RecordCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
                        <Button Grid.Column="2" Text="Пропустить" Style="{StaticResource Soft}" HeightRequest="44" MinimumHeightRequest="44"
                                Command="{Binding SkipCommand}" />
                      </Grid>
                    </VerticalStackLayout>
                  </Border>
                </DataTemplate>
              </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
          </VerticalStackLayout>

          <!-- Limits near or over: a nudge, not a report — the full list is in «Итоги». -->
          <Border Style="{StaticResource Card}" Padding="14,12" IsVisible="{Binding HasLimitWarnings}">
            <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding LimitWarnings}">
              <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="finance:LimitRow">
                  <controls:LimitBarView />
                </DataTemplate>
              </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
          </Border>

          <Label Text="Последние 30 дней" Style="{StaticResource SectionTitle}" Margin="0,4,0,0" />
        </VerticalStackLayout>
      </CollectionView.Header>
      <CollectionView.EmptyView>
        <Label Text="Операций пока нет — запишите первую строкой выше." Style="{StaticResource Muted}"
               HorizontalTextAlignment="Center" Margin="0,24" />
      </CollectionView.EmptyView>
      <CollectionView.Footer>
        <BoxView HeightRequest="16" Color="Transparent" />
      </CollectionView.Footer>
      <CollectionView.ItemTemplate>
        <DataTemplate x:DataType="finance:DayGroup">
          <VerticalStackLayout Spacing="6" Padding="0,12,0,0">
            <Grid ColumnDefinitions="*,Auto">
              <Label Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
              <Label Grid.Column="1" Text="{Binding TotalText}" Style="{StaticResource Muted}" />
            </Grid>
            <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding Rows}">
              <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="finance:OperationRow">
                  <controls:OperationRowView>
                    <controls:OperationRowView.GestureRecognizers>
                      <TapGestureRecognizer Tapped="OnRowTapped" />
                    </controls:OperationRowView.GestureRecognizers>
                  </controls:OperationRowView>
                </DataTemplate>
              </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
          </VerticalStackLayout>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>
  </Grid>
</ContentPage>
