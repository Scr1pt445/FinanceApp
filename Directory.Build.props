<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- One version for every project; shown in the settings window and as the Android versionName. 1.0 — the first release. -->
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- XML docs are written where they help, not on every public member. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>ru;en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
